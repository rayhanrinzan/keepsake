# Copy to .env at the repo root (git-ignored). Everything is optional; defaults are shown.
# Relative paths resolve from backend/ (where the server is started).

# Grok voice (Settings -> Customize voice): an xai-... key from console.x.ai.
# Each teammate needs it in their own .env; without it the browser voice is used.
XAI_API_KEY=

# Camera. Pick it by (part of) its name; indexes shift as cameras come and go.
# Use the name macOS shows for your phone, e.g. "iPhone" (check: python backend/check_camera.py).
# CTRLF_CAMERA_NAME=iPhone
CTRLF_CAMERA_INDEX=0
CTRLF_CAMERA_ENABLED=1
# wearable (chest-mounted iPhone, the default) or fixed (camera on a stand)
CTRLF_CAMERA_MODE=wearable
# 0 turns off MediaPipe hand evidence (pickup/put-down)
CTRLF_HANDS=1

# Detection. YOLO-World finds everything; models/items.pt (our trained keys, wallet, AirPods,
# glasses) is added on top automatically. Don't point CTRLF_MODEL at a COCO model like yolo11n.pt:
# it can't see keys, wallets, AirPods or glasses.
# CTRLF_MODEL=models/yolov8s-worldv2.pt
CTRLF_DETECT_CONFIDENCE=0.15
CTRLF_INFERENCE_FPS=5

# Memory
CTRLF_CONFIDENCE=0.35
CTRLF_STABILITY_FRAMES=4
CTRLF_SETTLE_SECONDS=0.8
CTRLF_MOVE_THRESHOLD=0.06
CTRLF_ABSENCE_SECONDS=2.0
CTRLF_DB_PATH=data/ctrlf.db
CTRLF_SNAPSHOT_DIR=data/snapshots
CTRLF_SNAPSHOT_RETENTION=20
CTRLF_SNAPSHOT_COOLDOWN=3

CTRLF_HOST=127.0.0.1
CTRLF_PORT=8000
