# All optional. Relative paths resolve from backend/ (where the server is started).
CTRLF_CAMERA_INDEX=0          # webcam index, or a path to a video file for testing
# CTRLF_CAMERA_NAME=iPhone    # pick the camera by name instead (macOS); indexes shift as cameras come and go
CTRLF_CAMERA_ENABLED=1        # 0 = run the API without a camera
CTRLF_CONFIDENCE=0.4          # minimum YOLO confidence
CTRLF_INFERENCE_FPS=5         # target inference rate (CPU-friendly)
CTRLF_STABILITY_FRAMES=4      # minimum settled frames before a placement is confirmed
CTRLF_SETTLE_SECONDS=0.8      # how long an item must hold still before its photo is taken
CTRLF_MOVE_THRESHOLD=0.06     # same-area distance (fraction of frame) that counts as a move
CTRLF_ABSENCE_SECONDS=2.0     # unseen this long => marked "not currently visible"
CTRLF_DB_PATH=data/ctrlf.db
CTRLF_SNAPSHOT_DIR=data/snapshots   # memory photos (git-ignored)
CTRLF_SNAPSHOT_RETENTION=20   # photos kept per item
CTRLF_SNAPSHOT_COOLDOWN=3     # seconds; same-spot photos within this are duplicates
CTRLF_REGIONS=regions.json
CTRLF_MODEL=models/yolo11n.pt
CTRLF_HOST=127.0.0.1
CTRLF_PORT=8000
