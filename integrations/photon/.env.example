# Top-level Spectrum credentials (from your Photon dashboard, or minted by create-spectrum-project).
PROJECT_ID=
PROJECT_SECRET=

# ---- Keepsake smart memory reminders ----
# Local Keepsake backend (must be this machine).
KEEPSAKE_API_URL=http://127.0.0.1:8000
# Photon-side switch, off by default. The backend also needs an explicit opt-in (a mode) before
# any reminder is queued: text "high assistance" / "everyday", or PUT /api/reminders/settings.
ALERTS_ENABLED=false
# Comma-separated E.164 numbers allowed to receive reminders and send commands. On Free/Pro each
# must also be a user of the Photon project (photon spectrum users add). Never commit real numbers.
ALERT_RECIPIENTS=
REMINDER_POLL_SECONDS=2
