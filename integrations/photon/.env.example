# Top-level Spectrum credentials (from your Photon dashboard, or minted by create-spectrum-project).
PROJECT_ID=
PROJECT_SECRET=

# ---- Keepsake Departure Alerts ----
# Local Keepsake backend (must be this machine).
KEEPSAKE_API_URL=http://127.0.0.1:8000
# Off by default. Nothing from Keepsake's memory is sent to Photon until this is true.
ALERTS_ENABLED=false
# Comma-separated E.164 numbers allowed to receive alerts and ask questions. On Free/Pro they must
# also be registered users of the Photon project (photon spectrum users add).
ALERT_RECIPIENTS=
# Catalog categories, names or aliases (see /api/catalog). Use any tracked item for demos.
IMPORTANT_ITEMS=keys,wallet,phone
# Only remind about items seen within this many minutes.
ALERT_MAX_AGE_MINUTES=180
# Don't mention the same item again within this many minutes.
ALERT_COOLDOWN_MINUTES=15
# Ignore departure events older than this (e.g. backlog after the agent was down).
DEPARTURE_MAX_EVENT_AGE_SECONDS=120
DEPARTURE_POLL_SECONDS=2
